// Copy this file to `wifi_secrets.h` (same directory) and fill it in.
//
//     cp main/wifi_secrets.h.example main/wifi_secrets.h
//
// `main/wifi_secrets.h` is gitignored. This `.example` file is not — never put
// a real SSID, passphrase or host address in it.
//
// Anything defined here overrides the corresponding `idf.py menuconfig` value
// under "Matrix Studio". Define only the ones you want to override; the rest
// fall back to sdkconfig. See main/app_config.h for how this is resolved.
//
// Note that these values end up as plain strings in the flashed binary either
// way. If that matters for your threat model, enable NVS encryption and flash
// encryption — this file is about keeping credentials out of git, not off the
// device.

#pragma once

#define MATRIX_STUDIO_SECRET_WIFI_SSID "your-network-name"
#define MATRIX_STUDIO_SECRET_WIFI_PASSWORD "your-network-password"

// Hostname or IP of the machine running the Matrix Studio Home Assistant
// add-on. An IP address avoids depending on mDNS resolution from the ESP32.
#define MATRIX_STUDIO_SECRET_SERVER_HOST "192.168.1.10"

// Protocol v1 default port (docs/protocol.md §6). Uncomment to override.
// #define MATRIX_STUDIO_SECRET_SERVER_PORT 7887
